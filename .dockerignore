# Version control
.git/
.gitignore

# Not needed to build the Go binary: reference-only source dumps and the
# separate Rust sleep-cycle worker (invoked as a subprocess per ADR-0005,
# not compiled into aisotropyd).
external/
crates/*/target/

# Docs, notes, and non-build metadata
docs/
raw-notes/
spikes/
bench/
*.md

# Editor/OS cruft and local tooling config
.claude/
.agent-tooling/
.vscode/
.idea/
.DS_Store

# Container/build artifacts that should never be baked into the context
Dockerfile
.dockerignore

# Secrets must never enter the build context — a COPY . . in any builder stage
# would otherwise bake them into an image layer (recoverable even after a later
# stage "removes" them). Belt-and-suspenders with the secret-scanning gate in
# scripts/supply-chain-guard.sh. See docs/deployment/supply-chain.md.
.env
.env.*
*.pem
*.key
*secret*
