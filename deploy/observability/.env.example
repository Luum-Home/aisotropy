# Copy to `.env` (gitignored) beside docker-compose.observability.yml.
# LOCAL-ONLY placeholders — never reuse production credentials here.

# Grafana admin login (change before exposing the UI anywhere).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Operator token for the OPT-IN /costs scrape. Must match aisotropyd's
# AISOTROPY_OPS_TOKEN. Used to render json-exporter/config.yml (see that file's
# header) — json_exporter does NOT read env vars itself, so render before `up`:
#   AISOTROPY_OPS_TOKEN=... envsubst < json-exporter/config.yml > json-exporter/config.rendered.yml
AISOTROPY_OPS_TOKEN=
