# ============================================================================
# aisotropy — environment template
# ----------------------------------------------------------------------------
# Copy to `.env` (gitignored) and fill in. NEVER commit real secrets — this
# file ships placeholders only. Every value here has a SAFE DEFAULT in code;
# unset means the documented default. A bare binary with NOTHING set boots on
# the in-process defaults (keyless stub LLM, in-mem tiers) — but see the
# "REQUIRED FOR PRODUCTION" markers below before exposing it to real traffic.
#
# Precedence: explicit env > a config file (AISOTROPY_CONFIG_FILE) > default.
# ============================================================================


# ── LLM PROVIDER (provider-agnostic, ADR-0009) ──────────────────────────────
# Pick ONE. Selection precedence: OpenRouter > OpenAI > Anthropic > keyless stub.
# Unset ALL of them => the stub LLM (canned replies, no cost) — dev/CI only.

# OpenRouter
#OPENROUTER_API_KEY=sk-or-REPLACE_ME
#OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
#OPENROUTER_MAX_TOKENS=1024

# OpenAI — OR any OpenAI-COMPATIBLE provider via OPENAI_BASE_URL.
# Two providers with a FREE developer tier are documented and supported:
#   poolside   OPENAI_BASE_URL=https://inference.poolside.ai/v1
#              OPENAI_MODEL=poolside/laguna-s-2.1
#   Agnes AI   OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
#              OPENAI_MODEL=agnes-2.0-flash
# Neither is privileged in code — they are two values of the same variables, and
# any other OpenAI-compatible endpoint works with no code change.
# Full detail, acknowledgements, and the rule that published model names are
# never rewritten: docs/architecture/model-provider.md
#OPENAI_API_KEY=sk-REPLACE_ME
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o-mini

# Anthropic
#ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
#ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Model routing / limits (optional overrides)
#AISOTROPY_MODEL=                     # override the default model name
#AISOTROPY_CHEAP_MODEL=               # cheap-model fallback under degradation
#AISOTROPY_VISION_MODEL=              # model for image-shaped requests
#AISOTROPY_MAX_TOKENS=1024
#AISOTROPY_REFLECTION_BACKEND=        # reflection engine selection
#AISOTROPY_JUDGE_MODEL=               # model for the eval LLM-as-judge (bench/answer-quality)


# ── SERVER / LISTEN ─────────────────────────────────────────────────────────
#AISOTROPY_ADDR=:8080                 # listen address. Also honors $PORT
                                      # (Cloud Run/Knative/ACA) when ADDR unset.
#PORT=                                # injected by container-serverless platforms
#AISOTROPY_REQUIRE_TLS=false          # reject plaintext bearer tokens (set true
                                      # in prod if TLS is NOT terminated upstream)


# ── AUTH  ★ REQUIRED FOR PRODUCTION (ADR-0024/0025/0042) ★ ───────────────────
# With NO JWT configured the binary REFUSES to boot unless you explicitly opt
# into NoAuth. NEVER run NoAuth in production.
#AISOTROPY_JWT_SECRET=change-me-to-a-random-32-byte-minimum-secret   # HS256
#AISOTROPY_JWT_PUBLIC_KEY=            # RS256 (PEM inline)  — OR:
#AISOTROPY_JWT_PUBLIC_KEY_FILE=       # RS256 (PEM file path)
#AISOTROPY_JWT_JWKS_URL=              # RS256 via JWKS endpoint
#AISOTROPY_JWT_ISSUER=                # optional-but-enforced-when-set
#AISOTROPY_JWT_AUDIENCE=              # optional-but-enforced-when-set
#AISOTROPY_JWT_MAX_TTL=24h            # cap token lifetime
# Dev-only escape hatch (loud warning; refuses on a non-loopback bind):
#AISOTROPY_ALLOW_NOAUTH=1             # trust path tenant/user with NO credential
#AISOTROPY_ALLOW_NOAUTH_NONLOCAL=1    # ALSO required to allow NoAuth off loopback (STRONGLY discouraged)
# Operator endpoints (/costs, /bitrate) — default-closed until this is set:
#AISOTROPY_OPS_TOKEN=change-me-ops-bearer-token


# ── CORS (browser clients) ──────────────────────────────────────────────────
# Comma-separated EXACT origin allowlist. Unset => no CORS headers (same-origin
# only). NEVER use "*" on a multi-tenant auth'd API.
#AISOTROPY_CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173


# ── WORKING MEMORY (BadgerDB) + DATA-AT-REST ────────────────────────────────
#AISOTROPY_DATA_DIR=                  # on-disk path; unset => in-memory (ephemeral)
#AISOTROPY_DATA_ENCRYPTION_KEY=       # AES at-rest for working memory; hex or base64,
                                      # decoded length 16/24/32 bytes. Never logged.


# ── FACTS MEMORY (SQLite / rqlite) ──────────────────────────────────────────
#AISOTROPY_FACTS_DB=                  # embedded SQLite path (with AISOTROPY_DATA_DIR)
#RQLITE_URL=http://rqlite:4001        # networked rqlite (with auth: http://user:pass@host:4001)
#AISOTROPY_FACT_MIN_IMPORTANCE=       # importance floor for indexing a fact


# ── SEMANTIC MEMORY (Qdrant) ────────────────────────────────────────────────
# Unset => in-process cosine (no service needed).
#QDRANT_HOST=qdrant
#QDRANT_PORT=6334                     # gRPC (app path)
#QDRANT_REST_PORT=6333                # REST (snapshots/backup)
#QDRANT_API_KEY=change-me-qdrant-key
#QDRANT_USE_TLS=false
#QDRANT_COLLECTION=aisotropy
#AISOTROPY_SEMANTIC_TURN_MAX=         # cap on raw-turn (KindTurn) vectors
#AISOTROPY_SEMANTIC_TURN_TTL=         # TTL for raw-turn vectors


# ── EMBEDDER (sovereign local, or BYO OpenAI-compatible) ────────────────────
# Unset => in-process hash embedder (dev). For real cross-lingual RAG use the
# local e5 subprocess (ADR-0023/0049/0054) or a networked embed endpoint.
#AISOTROPY_EMBED_BIN=                 # path to the crates/embed binary (local sovereign)
#AISOTROPY_EMBED_MODEL_DIR=           # local model dir (e.g. multilingual-e5-small)
#AISOTROPY_EMBED_MODEL=intfloat/multilingual-e5-small
#AISOTROPY_EMBED_DIM=384
#AISOTROPY_EMBED_MODE=daemon          # daemon (warm) | subprocess (cold)
#AISOTROPY_EMBED_E5_PREFIXES=1        # emit e5 query:/passage: prefixes (e5 models only)
#AISOTROPY_EMBED_URL=                 # OR a networked OpenAI-compatible embed endpoint
#AISOTROPY_EMBED_API_KEY=change-me-embed-key


# ── GUARDRAILS (AI safety) ──────────────────────────────────────────────────
#AISOTROPY_GUARDRAILS_BLOCK_INJECTION=true   # default ON (opt-OUT); reject Suspicious prompts
#AISOTROPY_GUARDRAILS_BLOCK_OUTPUT=false     # buffers the stream if on (latency tradeoff)
#AISOTROPY_GUARDRAILS_LLM_JUDGE=false        # opt-in LLM-as-judge on output (cost)
# Opt-in multilingual injection model (ADR-0052/0057) — subprocess, off by default:
#AISOTROPY_GUARDRAIL_MODEL_BIN=       # path to crates/guardrail-model binary
#AISOTROPY_GUARDRAIL_MODEL_DIR=       # mDeBERTa model dir
#AISOTROPY_GUARDRAIL_MODEL_MODE=daemon
#AISOTROPY_GUARDRAIL_HYPOTHESIS=      # NLI hypothesis override
#AISOTROPY_GUARDRAIL_THRESHOLD=0.5    # suspicion threshold


# ── RATE LIMIT / COST GOVERNANCE ────────────────────────────────────────────
#AISOTROPY_RATE_PER_SEC=              # per-tenant token-bucket refill rate
#AISOTROPY_BURST=                     # per-tenant token-bucket burst
#AISOTROPY_COST_BUDGET_USD=           # cost budget (degrade/reject over budget)


# ── AUDIT TRAIL (ADR-0047/0056) ─────────────────────────────────────────────
#AISOTROPY_AUDIT_LOG=/var/log/aisotropy/access.jsonl   # durable append-only JSONL; unset => slog
#AISOTROPY_AUDIT_HASHCHAIN=1          # tamper-evident hash chain (needs AUDIT_LOG)
#AISOTROPY_AUDIT_DISABLE=false        # explicit opt-out of the access trail


# ── MULTI-TENANT ROUTING ────────────────────────────────────────────────────
#AISOTROPY_DEDICATED_TENANTS=         # comma-separated tenants that get a dedicated tier


# ── OFFLINE WORKERS (opt-in Rust subprocesses, dormant by default) ──────────
#AISOTROPY_SLEEPCYCLE_BIN=            # path to crates/sleep-cycle (memory consolidation)
#AISOTROPY_BITRATE_BIN=               # path to the bits-per-token scorer worker


# ── PLUGINS / CONFIG FILE ───────────────────────────────────────────────────
#AISOTROPY_PLUGIN_DIR=                # directory of aisotropy-plugin.yaml plugins
#AISOTROPY_CONFIG_FILE=               # YAML/TOML config (env still wins; ADR-0040)


# ── OBSERVABILITY (OpenTelemetry) ───────────────────────────────────────────
# Unset => noop tracer (no export). Point at the OTLP collector to light up the
# deploy/observability stack (dashboards/SLOs/runbooks).
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# ── Arena + infra knobs the code reads but this file did not document ────────
# Found by an env-doc audit on 2026-07-27 (code-reachable vars vs documented
# vars). Reverse direction was clean: nothing documented here is unread.
# Deliberately still absent: HOME, RUSTC and the *_TEST_* fixtures — system and
# test-harness inputs, not deployment configuration.

# Arena live-runner (arenas/live/) — offline lane, no provider calls.
#ARENA_STUB=1                        # run the arena against the canned stub model
#ARENA_STUB_MODEL=stub               # model id the stub lane reports
#ARENA_STRICT_STRUCTURED=1           # fail (not warn) on a structured-output violation
#AISOTROPY_ARENA_CORPUS_DIR=arenas/live/_shared/corpus

# Qdrant — the semantic tier's two protocols. QDRANT_HOST/QDRANT_PORT (above)
# cover the common case; these override the ports independently, e.g. when a
# proxy or a compose overlay maps them apart.
#QDRANT_GRPC_PORT=6334
#QDRANT_REST_URL=http://localhost:6333

# OpenTelemetry metric export cadence (Go duration). Only consulted when
# OTEL_EXPORTER_OTLP_ENDPOINT is set; the exporter is a no-op otherwise.
#OTEL_EXPORTER_OTLP_METRIC_PERIOD=60s

# Sandbox image used by the key-brokering/task-agent tests (-tags keybroker).
#AISOTROPY_SANDBOX_TEST_IMAGE=alpine:3.20
