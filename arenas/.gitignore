# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node
node_modules/
*.lock

# Go compiled binaries — arenas run via `go run`, never commit build output.
# Anchored to arena roots so cmd/<name>/ source dirs are NOT ignored.
/adk-go/parity
/adk-go/costobs
/adk-go/server
/eino/parity
/eino/costobs
/eino/server
/genkit-go/parity
/genkit-go/costobs
/genkit-go/server

# Java / Spring build output
target/
*.class
*.jar
# eve (filesystem-first) build + runtime dirs
.eve/
.output/
# Cloudflare / wrangler local state
.wrangler/
# misc build/cache
dist/
.turbo/

# live arena — compiled adapter/runner binaries (built on demand, never committed)
/live/aisotropy/adapter-bin
/live/runner/runner
/live/*/adapter-bin

# arena runner compiled binary
aisotropy-live-runner
arenas/live/runner/aisotropy-live-runner
